# Copy to .dev.vars for local development. Never commit real values.
# This is the installation root key. Use a unique random value at least 32 characters long.
# Deploy to Cloudflare presents it as a secret; it never leaves your Cloudflare account.
CREDENTIAL_ENCRYPTION_KEY=

# These are filled after creating the Cloudflare Access application for OpenWA.
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com

# Legacy API-only deployments may additionally set META_ACCESS_TOKEN,
# META_APP_SECRET, WEBHOOK_VERIFY_TOKEN, and BOOTSTRAP_ADMIN_TOKEN locally.
