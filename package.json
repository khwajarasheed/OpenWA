{
  "name": "openwa-core",
  "version": "0.1.0",
  "private": true,
  "description": "Self-deployable WhatsApp Business API core for Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "landing:dev": "wrangler pages dev landing --config landing/wrangler.jsonc",
    "landing:deploy": "wrangler pages deploy landing --project-name openwa-landing --config landing/wrangler.jsonc",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.128.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260831.1": true
  }
}
