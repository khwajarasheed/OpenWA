{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openwa-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openwa-core",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "openwa-media"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "JOBS_QUEUE", "queue": "openwa-jobs" },
      { "binding": "DEAD_LETTER_QUEUE", "queue": "openwa-dlq" }
    ],
    "consumers": [
      { "queue": "openwa-jobs", "max_batch_size": 10, "max_retries": 10, "dead_letter_queue": "openwa-dlq" }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PHONE_DISPATCHER", "class_name": "PhoneDispatcher" },
      { "name": "INSTALLATION_SECRETS", "class_name": "InstallationSecrets" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PhoneDispatcher"] },
    { "tag": "v2", "new_sqlite_classes": ["InstallationSecrets"] }
  ],
  "triggers": { "crons": ["*/5 * * * *"] }
}
